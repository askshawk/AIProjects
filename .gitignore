# Environment variables
.env
.env.local
.env.*.local

# Secrets / OAuth credentials (e.g. newsletter-digest Gmail API)
credentials.json
token.json

# Claude Code local state (worktrees, agent data)
.claude/

# Python — these are Python packaging/build artefacts. Scope them so they
# don't accidentally match source dirs in JS projects (notably web/lib/).
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
MANIFEST
# venv / build dirs (rooted so they only match at the repo root and inside
# Python project subdirs that opt in via their own .gitignore)
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/pip-wheel-metadata/
/share/python-wheels/
.installed.cfg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Database
*.db
# Runtime data dirs for the Python projects. Scoped per-project rather than a
# bare `data/`, which also matched iron-atlas/src/data — silently untracking
# the exercise catalogue that the whole app is seeded from.
/sentinel/data/
/news-analysis/data/

# Logs
*.log

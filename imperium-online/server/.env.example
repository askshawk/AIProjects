# Copy to .env and edit. Everything has safe local defaults, so .env is
# optional for development.
#
# In production set APP_ENV=production — the app then REFUSES to start on any
# of the development defaults below, rather than running insecurely and looking
# healthy. See app/config.py.
APP_ENV=dev

# Where state lives. Unset → local SQLite file (./imperium.db). In production,
# point this at Postgres, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/imperium
DATABASE_URL=sqlite:///./imperium.db

# Secret used to sign JWTs. CHANGE THIS in production — anyone with it can mint
# tokens for any account. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-me

# Comma-separated origins allowed to call the API (the Next.js dev server).
# In production this must be the exact deployed web origin — '*' is rejected,
# because a wildcard cannot be combined with credentialed (cookie) requests.
CORS_ORIGINS=http://localhost:3000

# --- session cookie (Phase 8a) ---
# The session is an httpOnly cookie, not a token in localStorage. Locally the
# app and API share localhost, so SameSite=Lax works and Secure must stay off
# (a Secure cookie is never set over plain http). In production the API is on a
# different domain to the app, which requires SameSite=None + Secure.
COOKIE_SECURE=0
# COOKIE_SAMESITE defaults to lax when COOKIE_SECURE=0 and none when it is 1.
# COOKIE_SAMESITE=lax

# --- rate limiting (Phase 8b) ---
# Sliding-window budgets per client IP. Set RATE_LIMIT_ENABLED=0 to switch off.
# Auth covers /login and /register (brute force, account spam); write covers
# every other POST/PUT/PATCH/DELETE; global covers everything.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_AUTH=10       # per 5 minutes
RATE_LIMIT_WRITE=120     # per minute
RATE_LIMIT_GLOBAL=600    # per minute

# Set to 1 ONLY when a trusted proxy (Fly, a load balancer) sets
# X-Forwarded-For. Trusting it otherwise lets any client forge an address and
# hand itself a fresh budget on every request.
TRUST_PROXY=0

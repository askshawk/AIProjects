# Copy to .env and edit. Both have safe local defaults, so .env is optional for dev.

# Where state lives. Unset → local SQLite file (./imperium.db). In production,
# point this at Postgres, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/imperium
DATABASE_URL=sqlite:///./imperium.db

# Secret used to sign JWTs. CHANGE THIS in production — anyone with it can mint
# tokens for any account. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-me

# Comma-separated origins allowed to call the API (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000

# --- rate limiting (Phase 8b) ---
# Sliding-window budgets per client IP. Set RATE_LIMIT_ENABLED=0 to switch off.
# Auth covers /login and /register (brute force, account spam); write covers
# every other POST/PUT/PATCH/DELETE; global covers everything.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_AUTH=10       # per 5 minutes
RATE_LIMIT_WRITE=120     # per minute
RATE_LIMIT_GLOBAL=600    # per minute

# Set to 1 ONLY when a trusted proxy (Fly, a load balancer) sets
# X-Forwarded-For. Trusting it otherwise lets any client forge an address and
# hand itself a fresh budget on every request.
TRUST_PROXY=0

# Local Postgres (PGlite). Start it with `npm run db` in its own terminal.
# Port 5433 so it can run alongside Iron Atlas's local database on 5432.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres

# The passcode you type to sign in (at least 8 characters).
APP_PASSCODE=

# Optional, advanced: instead of APP_PASSCODE, store only a scrypt hash
# (npm run passcode:hash -- "your passcode") and a separate SESSION_SECRET.
# APP_PASSCODE_HASH=
# SESSION_SECRET=

# Optional, and the only paid part: Claude-powered features (graded Explain It
# Back, live calls, boss battles, notes to cards, Ask my glossary).
ANTHROPIC_API_KEY=

# Embeddings for Ask my glossary.
VOYAGE_API_KEY=

# Optional. Defaults shown.
# AI_MONTHLY_BUDGET_USD=20
# AI_DAILY_CALL_CAP=150
# AI_DISABLED=1
# WEEKLY_XP_QUOTA=600
# APP_TIMEZONE=America/Los_Angeles

# Local Postgres (PGlite). Start it with `npm run db` in its own terminal.
# Port 5433 so it can run alongside Iron Atlas's local database on 5432.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres

# The passcode you type to sign in, stored as a hash. Generate it with:
#   npm run passcode:hash -- "your passcode here"
# and paste the output here. Never commit the real value.
APP_PASSCODE_HASH=

# Signs the session cookie. Any long random string; changing it signs you out
# everywhere. Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# Claude-powered features (Explain It Back, live calls, boss battles, notes to
# cards, Ask my glossary). Optional locally; those pages say when it's missing.
ANTHROPIC_API_KEY=

# Embeddings for Ask my glossary.
VOYAGE_API_KEY=

# Optional. Defaults shown.
# AI_MONTHLY_BUDGET_USD=20
# AI_DAILY_CALL_CAP=150
# AI_DISABLED=1
# WEEKLY_XP_QUOTA=600
# APP_TIMEZONE=America/Los_Angeles
